{
  "name": "ssh-manager",
  "version": "1.0.0-beta",
  "main": "src/main/main.js",
  "scripts": {
    "start": "concurrently \"npm run server\" \"electron .\"",
    "react-start": "cd src/renderer && npm start",
    "server": "node src/main/server.js",
    "electron-dev": "concurrently \"npm run react-start\" \"npm run server\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "electron-builder"
  },
  "devDependencies": {
    "concurrently": "^6.5.1",
    "electron": "^13.1.7",
    "electron-builder": "^25.1.8",
    "wait-on": "^5.3.0"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "sqlite3": "^5.1.7",
    "ssh2": "^1.16.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "build": {
    "appId": "com.mycompany.my-electron-app",
    "productName": "vosoft-ssh-manager",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": []
    }
  }
}
